    "canvas-confetti": "^1.9.4",
    "gray-matter": "^4.0.3",
    "medium-zoom": "^1.1.0",
    "mermaid": "^11.17.2",
    "typescript": "^5.9.0",
    "vitepress": "1.6.4",
    "vitepress-plugin-llms": "^1.14.0",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.44",
    "vue-tsc": "^2.2.10"
  },
  "dependencies": {
    "lucide-vue-next": "^0.545.0"
